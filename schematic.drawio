  <diagram name="CAN und OBD" id="roadtest-can">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="c0"/>
        <mxCell id="c1" parent="c0"/>

        <mxCell id="c-title" value="ROADTEST – CAN / OBD-II" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#1F2937;" vertex="1" parent="c1">
          <mxGeometry x="390" y="20" width="820" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c-subtitle" value="Joy-IT SBC-CAN01 · MCP2515 + MCP2562 · 16-MHz-Quarz · nur lesender Betrieb" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#4B5563;" vertex="1" parent="c1">
          <mxGeometry x="350" y="60" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="c-mcu" value="ESP32-S3 Controller&#xa;&#xa;GPIO 1  → CS&#xa;GPIO 2  ← INT&#xa;GPIO 3  → SCK&#xa;GPIO 13 → MOSI / SI&#xa;GPIO 11 ← MISO / SO&#xa;GND      ↔ GND&#xa;&#xa;Achtung: GPIO 3 ist ein Strapping-Pin.&#xa;Beim Reset keinen störenden Pegel erzwingen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontStyle=1;fontSize=13;align=left;spacingLeft=18;" vertex="1" parent="c1">
          <mxGeometry x="90" y="210" width="340" height="410" as="geometry"/>
        </mxCell>

        <mxCell id="c-can" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#2F80C0;strokeWidth=2;" vertex="1" parent="c1">
          <mxGeometry x="570" y="150" width="500" height="570" as="geometry"/>
        </mxCell>
        <mxCell id="c-can-title" value="Joy-IT SBC-CAN01" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#174A75;" vertex="1" parent="c1">
          <mxGeometry x="650" y="170" width="340" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="c-logic" value="MCP2515 CAN-Controller&#xa;Logikversorgung: VCC = 3,3 V&#xa;SPI-Pegel bleiben 3,3 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="620" y="240" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c-xcvr" value="MCP2562 CAN-Transceiver&#xa;Bustreiberversorgung: VCC1 = 5 V&#xa;5 V dürfen nicht auf die SPI-Leitungen gelangen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontStyle=1;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="620" y="380" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c-term" value="P1 / 120-Ω-Abschluss&#xa;&#xa;Fahrzeugbetrieb: Jumper offen / abgezogen&#xa;Keine zusätzliche Terminierung am Stichkabel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="620" y="530" width="400" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c-can-label" value="CANH / CANL am Transceiver-Ausgang – nicht am MCP2515" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#4B5563;" vertex="1" parent="c1">
          <mxGeometry x="620" y="660" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="c-obd" value="Fahrzeug OBD-II&#xa;&#xa;Pin 6  = CAN-H&#xa;Pin 14 = CAN-L&#xa;Masse  = gemeinsame Masse&#xa;&#xa;Stichleitung möglichst kurz, Ziel &lt; 30 cm.&#xa;Keine DTC-Löschung, Codierung oder Stellgliedansteuerung." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="1200" y="250" width="330" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="c-e-spi" value="SPI · CS / INT / SCK / MOSI / MISO" style="endArrow=none;html=1;strokeColor=#229954;strokeWidth=3;fontStyle=1;" edge="1" parent="c1" source="c-mcu" target="c-logic">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-internal" value="CAN TX/RX intern" style="endArrow=none;html=1;strokeColor=#6C8EBF;strokeWidth=2;" edge="1" parent="c1" source="c-logic" target="c-xcvr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-canh" value="CAN-H → OBD Pin 6" style="endArrow=classic;html=1;strokeColor=#C0392B;strokeWidth=3;fontStyle=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="c1" source="c-xcvr" target="c-obd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-canl" value="CAN-L → OBD Pin 14" style="endArrow=classic;html=1;strokeColor=#2F80C0;strokeWidth=3;fontStyle=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.65;entryX=0;entryY=0.58;" edge="1" parent="c1" source="c-xcvr" target="c-obd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-term" value="schaltbar über P1" style="endArrow=none;html=1;strokeColor=#D6B656;strokeWidth=2;dashed=1;fontSize=10;" edge="1" parent="c1" source="c-term" target="c-xcvr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c-v33" value="geregelte 3,3 V&#xa;→ VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontStyle=1;" vertex="1" parent="c1">
          <mxGeometry x="570" y="780" width="190" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c-v5" value="geregelte 5 V&#xa;→ VCC1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;strokeWidth=2;fontStyle=1;" vertex="1" parent="c1">
          <mxGeometry x="790" y="780" width="190" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c-gnd" value="gemeinsame Masse&#xa;Controller ↔ SBC-CAN01 ↔ Fahrzeug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontStyle=1;" vertex="1" parent="c1">
          <mxGeometry x="1010" y="780" width="330" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-v33" style="endArrow=classic;html=1;strokeColor=#B85450;strokeWidth=3;edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=0;entryY=0.5;" edge="1" parent="c1" source="c-v33" target="c-logic">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="590" y="745"/>
              <mxPoint x="590" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c-e-v5" style="endArrow=classic;html=1;strokeColor=#C0392B;strokeWidth=3;edgeStyle=orthogonalEdgeStyle;rounded=1;entryX=1;entryY=0.5;" edge="1" parent="c1" source="c-v5" target="c-xcvr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="745"/>
              <mxPoint x="1040" y="435"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c-e-gnd-mcu" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=3;" edge="1" parent="c1" source="c-gnd" target="c-mcu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-gnd-can" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=3;" edge="1" parent="c1" source="c-gnd" target="c-can">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c-e-gnd-obd" style="endArrow=none;html=1;strokeColor=#666666;strokeWidth=3;" edge="1" parent="c1" source="c-gnd" target="c-obd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c-warning" value="Wichtiger Versorgungstest vor dem Fahrzeuganschluss&#xa;&#xa;1. VCC einzeln gegen GND messen: 3,3 V&#xa;2. VCC1 einzeln gegen GND messen: 5 V&#xa;3. Prüfen, dass an CS/INT/SCK/MOSI/MISO niemals 5 V anliegen&#xa;4. P1 abgezogen und CAN-H/CAN-L korrekt zugeordnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;fontStyle=1;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="90" y="700" width="400" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="c-mode" value="Firmwarebetrieb&#xa;&#xa;ISO 15765-4 · 11-Bit · 500 kbit/s&#xa;OBD Service 01 Livewerte · nur lesend&#xa;CAN vor Firmware-Upload vom Fahrzeug trennen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="c1">
          <mxGeometry x="1200" y="620" width="330" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="c-source" value="Verbindlich sind die Anschlussnamen auf dem fotografierten SBC-CAN01. Verifizierte IC-Pins stehen in pin_reference.md." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#4B5563;" vertex="1" parent="c1">
          <mxGeometry x="480" y="920" width="700" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
