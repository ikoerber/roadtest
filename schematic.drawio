        <mxCell id="a-mcu" value="ESP32-S3 Controller&#xa;&#xa;Boardtyp über „diag“ verifizieren&#xa;Firmware-Ziel aktuell: lolin_s3_mini&#xa;&#xa;I²C&#xa;GPIO 8  = SDA&#xa;GPIO 9  = SCL · 100 kHz&#xa;&#xa;UART GPS&#xa;GPIO 16 = RX ← GPS TX&#xa;GPIO 15 = TX → GPS RX&#xa;&#xa;SPI MicroSD&#xa;GPIO 4 = CS · 5 = MOSI&#xa;GPIO 6 = MISO · 7 = SCLK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontStyle=1;fontSize=12;align=left;spacingLeft=16;" vertex="1" parent="a1">
          <mxGeometry x="650" y="150" width="350" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="a-oled" value="SSD1306 OLED (optional)&#xa;&#xa;VCC → 3,3 V&#xa;GND → GND&#xa;SDA → GPIO 8&#xa;SCL → GPIO 9&#xa;&#xa;Adresse 0x3C oder 0x3D&#xa;Nur stromlos stecken/ziehen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="a1">
          <mxGeometry x="1110" y="120" width="390" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a-gps" value="Beitian BN-880 · fotografierter 6-Pin-Anschluss&#xa;&#xa;VCC → geregelte 3,3 V&#xa;GND → gemeinsame Masse&#xa;TX → GPIO 16 (RX)&#xa;RX ← GPIO 15 (TX)&#xa;SCL / SDA → nicht benutzt&#xa;&#xa;UART 9600 Baud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="a1">
          <mxGeometry x="1110" y="360" width="390" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a-sd" value="PZSMOCN MicroSD-Modul&#xa;&#xa;VCC → geregelte 3,3 V&#xa;GND → gemeinsame Masse&#xa;CS → GPIO 4&#xa;DI / MOSI → GPIO 5&#xa;DO / MISO → GPIO 6&#xa;SCLK → GPIO 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="a1">
          <mxGeometry x="1110" y="620" width="390" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="a-e-i2c" value="I²C · GPIO 8 SDA / GPIO 9 SCL" style="endArrow=none;html=1;strokeColor=#2F80C0;strokeWidth=3;fontStyle=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="a1" source="a-bno" target="a-mcu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-e-oled" value="gemeinsamer I²C-Bus · GPIO 8/9" style="endArrow=none;html=1;strokeColor=#2F80C0;strokeWidth=3;fontStyle=1;" edge="1" parent="a1" source="a-mcu" target="a-oled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-e-gps" value="UART · GPIO 15/16" style="endArrow=none;html=1;strokeColor=#8E44AD;strokeWidth=3;fontStyle=1;" edge="1" parent="a1" source="a-mcu" target="a-gps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-e-sd" value="SPI · GPIO 4/5/6/7" style="endArrow=none;html=1;strokeColor=#229954;strokeWidth=3;fontStyle=1;" edge="1" parent="a1" source="a-mcu" target="a-sd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a-power" value="Versorgung des aktiven Aufbaus&#xa;&#xa;3,3 V geregelt: BNO055 VIN, OLED VCC, BN-880 VCC, MicroSD VCC&#xa;GND: eine gemeinsame Masse für Controller und alle Module&#xa;&#xa;Keines dieser Module direkt an eine rohe LiPo-Zelle anschließen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="a1">
          <mxGeometry x="150" y="730" width="850" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="a-check" value="Vor dem Einschalten prüfen&#xa;&#xa;• 3,3-V-Schiene gegen GND messen&#xa;• Durchgang der gemeinsamen Masse prüfen&#xa;• Keine 5-V-Signale an ESP32-GPIOs&#xa;• OLED nur stromlos an-/abstecken" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="a1">
          <mxGeometry x="1110" y="860" width="390" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="a-legend-i2c" value="I²C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#2F80C0;fontStyle=1;" vertex="1" parent="a1">
